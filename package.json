{
  "name": "fairlight-xtouch-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCU bridge between Behringer X-Touch controllers and Fairlight Live (Ember+)",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/cli.js",
    "dev": "tsx src/cli.ts",
    "settings": "tsx src/cli.ts settings",
    "settings:demo": "tsx src/cli.ts settings --demo",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "test:watch": "node --import tsx --test --watch \"test/**/*.test.ts\"",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@julusian/midi": "^3.9.0",
    "@phillipivan/emberplus-connection": "0.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "allowScripts": {
    "@julusian/midi@3.9.0": true,
    "esbuild@0.28.2": true
  }
}
